# Dependencies and generated output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Husky writes its internal shim directory on `npm install`; it is regenerated, not versioned
.husky/_/

# Local environment and logs: may contain secrets or machine-specific values
.env
.env.*
!.env.example
*.log
npm-debug.log*

# Editor and OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
